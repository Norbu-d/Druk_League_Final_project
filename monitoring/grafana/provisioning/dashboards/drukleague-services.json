      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 4,
      "targets": [{"expr": "sum by (service) (increase(drukleague_grpc_server_requests_total{code=\"OK\"}[$__range]))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Successful gRPC requests in selected range",
      "type": "timeseries"
    }
